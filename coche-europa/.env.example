# --- Busqueda en vivo (opcional) ---------------------------------------------
# Sin estas variables la app funciona igual: cada portal se abre por enlace
# profundo con los filtros ya aplicados. Con ellas, los resultados de esos
# portales aparecen mezclados en la lista unificada.

# Puente propio (n8n / scraper en tu Oracle). Ver n8n/coche-europa-bridge.json
# y el contrato en README.md.
BRIDGE_URL=
BRIDGE_TOKEN=

# eBay Browse API (oficial y gratuita). https://developer.ebay.com
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_DE
