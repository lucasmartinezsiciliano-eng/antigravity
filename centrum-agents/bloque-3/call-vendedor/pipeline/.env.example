# ═══════════════════════════════════════════════════════════════════════════
# Ana — pipeline de voz · variables de entorno
# Copiar a .env y rellenar. NUNCA commitear el .env real (va en .gitignore).
# Cuenta Twilio = NUEVA, bajo Mediterránea Firmax SL. No reutilizar otras cuentas.
# ═══════════════════════════════════════════════════════════════════════════

# ── Twilio (único componente externo — transporte telefónico) ────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+34xxxxxxxxx          # número Centrum (España)

# ── LLM local (vLLM ya levantado por vllm-start.sh) ──────────────────────────
# Gemma 4 26B-A4B (Pro) en :8002. Escalable a 31B (Max) en :8003 si hace falta.
LLM_BASE_URL=http://localhost:8002/v1
LLM_MODEL=gemma-4-26B-A4B-it
LLM_API_KEY=not-needed                    # vLLM no exige clave; placeholder

# ── STT local (Whisper Large v3, faster-whisper en CUDA) ─────────────────────
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# ── TTS local (servidor XTTS-v2 aparte, ver README) ──────────────────────────
XTTS_BASE_URL=http://localhost:8010
XTTS_VOICE=Ana Florence                   # voz integrada ES; o id de voz clonada
XTTS_LANGUAGE=es

# ── Servidor del pipeline (este proceso) ─────────────────────────────────────
HOST=0.0.0.0
PORT=8090
PUBLIC_WS_URL=wss://centrum-call.example.com/ws   # URL pública del media stream
                                                  # (túnel/ngrok en dev, dominio en prod)

# ── Almacenamiento de casos (RGPD: datos del cliente SOLO aquí, local) ───────
CASES_DIR=/root/.hermes/profiles/centrum/cases

# ── Orquestador (para emitir el evento call_ia_completada de vuelta) ─────────
ORCHESTRATOR_EVENT_URL=http://localhost:8099/events
