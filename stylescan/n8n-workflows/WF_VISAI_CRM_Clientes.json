      "name": "Merge — ID Persona",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1520, 540],
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst data = input?.data;\n\n// Viene de PATCH (updatePerson) o POST (createPerson)\nconst persona = data?.updatePerson || data?.createPerson || {};\nconst personaId = persona?.id || $('¿Persona existe?').item.json.persona_id;\n\nreturn [{\n  json: {\n    ...$('¿Persona existe?').item.json,\n    persona_id: personaId\n  }\n}];"
