    {
      "id": "check-existe",
      "name": "¿Persona existe?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [860, 540],
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst people = data?.data?.people || [];\nconst persona = people[0] || null;\n\nconst parsed = $('Parse Payload').item.json;\n\nreturn [{\n  json: {\n    ...parsed,\n    persona_existe: !!persona,\n    persona_id: persona?.id || null\n  }\n}];"
      }
    },
