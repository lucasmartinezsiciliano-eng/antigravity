# --- Servidor ---------------------------------------------------------------
PORT=8080
CORS_ORIGIN=*
PROVIDER_TIMEOUT_MS=12000
VERBOSE=false

# Identificate de verdad y pon un contacto real. Un User-Agent honesto es la
# diferencia entre que te llamen para avisarte y que te bloqueen sin preguntar.
USER_AGENT=coche-api/0.1 (metabusqueda bajo demanda; +https://tu-dominio/contacto)

# --- Proveedores ------------------------------------------------------------
# Por defecto corren los de enlace profundo y las APIs oficiales.
# Los de lectura de HTML hay que encenderlos a mano, a sabiendas.
# PROVIDERS_ENABLED=autoscout24-html,mobile-de-html
# PROVIDERS_DISABLED=milanuncios

# Saltarse robots.txt. Piensalo dos veces: si lo pones, queda en el log.
IGNORE_ROBOTS=false

# --- eBay Browse API (oficial y gratuita) -----------------------------------
# Alta en https://developer.ebay.com -> credenciales de produccion
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_DE

# --- Puente con coche-europa ------------------------------------------------
# Si lo pones, /bridge exige Authorization: Bearer <token>
BRIDGE_TOKEN=
